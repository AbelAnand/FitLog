# The app needs no configuration: it stores everything on the device and talks to no server.
#
# These two values are only read by `npm run export:server`, which downloads an account's data
# from the old online version of FitLog. Put them in .env.local.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
